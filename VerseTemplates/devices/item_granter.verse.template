using { /Fortnite.com/Devices }
using { /Fortnite.com/Characters }
using { /Verse.org/Simulation }

# {{DESCRIPTION}}
# Template: Item Granter Device
# Grants items to players based on triggers or conditions

{{MODULE_NAME}} := class(creative_device):

    @editable
    ItemGranter<private>: item_granter_device = item_granter_device{}

    @editable
    GrantTrigger<private>: trigger_device = trigger_device{}

    OnBegin<override>()<suspends>:void=
        GrantTrigger.TriggeredEvent.Subscribe(OnTriggerActivated)

    OnTriggerActivated(Agent:?agent):void=
        if (PlayerAgent := Agent?):
            GrantItemToPlayer(PlayerAgent)

    GrantItemToPlayer(Agent:agent):void=
        ItemGranter.GrantItem(Agent)
        Print("Granted item to {Agent}")

    GrantItemToAll():void=
        ItemGranter.GrantItemToAll()
