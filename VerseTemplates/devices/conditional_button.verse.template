        {{#IF_ITEM_CONDITION}}
        PlayerHasRequiredItem(Agent)
        {{/IF_ITEM_CONDITION}}

        {{#IF_TEAM_CONDITION}}
        IsCorrectTeam(Agent)
        {{/IF_TEAM_CONDITION}}

