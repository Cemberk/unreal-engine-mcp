# Show leaderboard
ShowLeaderboard<public>(Scores:[]tuple(string, int), HUDDevice:hud_message_device):void=
    var LeaderboardText:string = "LEADERBOARD\n"

    for (Index -> Entry : Scores):
        PlayerName := Entry(0)
        Score := Entry(1)
        set LeaderboardText = "{LeaderboardText}\n{Index + 1}. {PlayerName}: {Score}"

    ShowMessageToAll(LeaderboardText, HUDDevice)

# Show progress bar (using text)
ShowProgressBar<public>(Progress:float, BarLength:int):string=
    FilledLength := Floor(Progress * Float[BarLength])
    var Bar:string = "["

    for (I := 0..BarLength - 1):
        if (I < FilledLength):
            set Bar = "{Bar}■"
        else:
            set Bar = "{Bar}□"

    set Bar = "{Bar}] {Floor(Progress * 100.0)}%"
    return Bar

