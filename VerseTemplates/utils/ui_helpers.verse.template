# Display countdown timer
ShowCountdown<public>(Seconds:int, HUDDevice:hud_message_device)<suspends>:void=
    for (I := Seconds..1):
        ShowMessageToAll("{I}...", HUDDevice)
        Sleep(1.0)
    ShowMessageToAll("GO!", HUDDevice)
    Sleep(1.0)
    # HUDDevice.HideAll()

