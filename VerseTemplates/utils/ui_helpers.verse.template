# Format time in MM:SS
FormatTime<public>(Seconds:float):string=
    TotalSeconds := Floor(Seconds)
    Minutes := TotalSeconds / 60
    RemainingSeconds := TotalSeconds mod 60

    MinStr := if (Minutes < 10) then "0{Minutes}" else "{Minutes}"
    SecStr := if (RemainingSeconds < 10) then "0{RemainingSeconds}" else "{RemainingSeconds}"

    return "{MinStr}:{SecStr}"

