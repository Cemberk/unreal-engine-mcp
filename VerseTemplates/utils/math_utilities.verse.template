# Power function
Pow<public>(Base:float, Exponent:int):float=
    if (Exponent = 0):
        return 1.0

    var Result:float = Base
    for (I := 1..AbsInt(Exponent) - 1):
        set Result = Result * Base

    if (Exponent < 0):
        return 1.0 / Result

    return Result

